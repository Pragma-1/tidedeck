# Copy to .env and adjust.

# Port on the host. The app always listens on 3000 inside the container.
PORT=3000

# User/group that owns ./data on the host
PUID=1000
PGID=1000

# Optional: set the admin password on first start instead of in the browser.
# Ignored once a password exists (change it later under Settings → Password).
# ADMIN_PASSWORD=

# Optional: turn off the built-in sign-in entirely (everyone can edit).
# Only do this behind a reverse proxy that does its own auth (Authelia, Cloudflare Access, …).
# AUTH_DISABLED=true
