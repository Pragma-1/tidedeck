# Copy to ".env" and fill in. Everything here is optional except WIKI_BASE_URL if you use a domain/HTTPS.
# Never commit your real .env.

# --- Container basics ---
# User/group the wiki runs as. The data folder is chown'ed to this on start (like linuxserver.io images).
# Match your host user ("id -u" / "id -g"); Unraid is usually 99 / 100. 0 (root) is refused.
PUID=1000
PGID=1000
# Host port the wiki is published on (inside the container it is always 3000).
WIKI_PORT=3000
# Uploaded files, the generated master key and the setup token. A folder path or a named volume.
WIKI_DATA=./data
# Where backups go on the host (encrypted). Another disk or a NAS share, so a dead disk doesn't take
# the wiki and its backups at once — docker.yaml shows NFS and SMB. S3 is set up in the wiki instead:
# Einstellungen → Sicherungen. Schedule and retention are set there too.
WIKI_BACKUPS=./backups
# In the wiki the owner can switch backups off, or pick another folder for them — but only inside
# these folders of the container (mount disks/shares there in docker.yaml). Comma separated.
# WIKI_BACKUP_ROOTS=/backups,/mnt,/media,/srv

# --- Database (PostgreSQL, its own container) ---
# Name of the database and of the wiki's own database user (no superuser rights).
DB_NAME=tidewiki
DB_USER=tidewiki
# Password of that user. Long and random:  openssl rand -base64 32
DB_PASSWORD=
# The database administrator (superuser). Only the database container gets this password.
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=
# Where the database files live on the host. A local disk, please (no SMB share).
DB_DATA=./db
# Advanced: an existing PostgreSQL server instead of the container (then remove the "db" service):
# WIKI_DB_HOST=, WIKI_DB_PORT=5432, WIKI_DB_NAME=, WIKI_DB_USER=, WIKI_DB_PASSWORD= (or WIKI_DATABASE_URL=),
# WIKI_DB_PASSWORD_FILE= for Docker secrets, WIKI_DB_SSL=off|require|verify.

# --- Where the wiki is reachable (exactly what users type in the browser) ---
# https:// turns on Secure cookies + HSTS. Also used for password-reset links.
# (If you change WIKI_PORT, change the port here too.)
WIKI_BASE_URL=http://localhost:3000
# Extra host names the wiki is opened under (comma separated). IP addresses and localhost always work;
# any other name must be the one in WIKI_BASE_URL or listed here, otherwise saving is blocked (anti DNS-rebinding).
WIKI_ALLOWED_HOSTS=
# Number of reverse proxies in front (Traefik, Caddy, nginx...). 0 = none, 1 = one proxy.
# Only set >0 if a proxy really sits in front, otherwise client IPs can be spoofed.
WIKI_TRUSTED_PROXY_HOPS=0
WIKI_TIMEZONE=Europe/Berlin

# --- Master key (encrypts 2FA secrets and all backups, peppers password hashes) ---
# Leave empty and one is generated inside the data volume on first start.
# Recommended: set your own and keep a copy OUTSIDE the volume and away from the backups:  openssl rand -base64 48
# WARNING: if you lose or change it, nobody can log in anymore, all 2FA must be reset
# and NO BACKUP can be read any more.
WIKI_MASTER_KEY=

# --- First start only: your own setup token (min. 16 chars). Empty = random token printed in the container log ---
WIKI_SETUP_TOKEN=

# --- E-mail (optional). Easier: set it up in the wiki under Einstellungen → E-Mail; a server set there overrides these ---
# Leave SMTP_HOST empty to disable mail from .env.
SMTP_HOST=
SMTP_PORT=587
# starttls | tls | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Uploads (optional) ---
# Largest video file in MB (images are capped at 15 MB) and total space for all uploads in MB.
WIKI_MAX_VIDEO_MB=200
WIKI_MEDIA_QUOTA_MB=10240
# Largest import file (ZIP or .md) in MB.
WIKI_MAX_IMPORT_MB=1024
# Largest backup ZIP that can be uploaded for a restore, in MB.
WIKI_MAX_BACKUP_UPLOAD_MB=20480
