{
  "name": "tidewiki",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "lint": "eslint src"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@node-rs/argon2": "2.2.2",
    "better-sqlite3": "13.0.3",
    "diff": "9.0.0",
    "fflate": "0.8.3",
    "highlight.js": "11.12.0",
    "lucide-react": "1.66.0",
    "markdown-it": "15.0.3",
    "markdown-it-abbr": "2.0.0",
    "markdown-it-anchor": "10.0.0",
    "markdown-it-container": "4.0.0",
    "markdown-it-deflist": "4.0.0",
    "markdown-it-emoji": "3.1.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-ins": "4.0.0",
    "markdown-it-mark": "4.0.0",
    "markdown-it-sub": "2.0.0",
    "markdown-it-sup": "2.0.0",
    "markdown-it-task-lists": "2.1.1",
    "next": "16.4.6",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "@aws-crypto/sha256-js": "5.2.0",
    "@smithy/protocol-http": "5.6.2",
    "@smithy/signature-v4": "5.7.5",
    "@tailwindcss/postcss": "4.3.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/markdown-it": "14.2.0",
    "@types/markdown-it-container": "4.0.1",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "description": "Self-hosted Markdown wiki: live pages, 2FA, substring search, GDPR tools — one Docker container.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pragma-1/tidewiki.git"
  },
  "homepage": "https://github.com/Pragma-1/tidewiki#readme",
  "bugs": {
    "url": "https://github.com/Pragma-1/tidewiki/issues"
  }
}
